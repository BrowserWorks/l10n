# Variables:
#   $version (String) - The Waterfox release series, e.g. 6.7.
waterfox-upgrade-dialog-title = Fáilte go dtí { -brand-short-name } { $version }
waterfox-upgrade-dialog-subtitle = Tugann an nuashonrú seo inneall brabhsálaí níos nuaí, cluaisíní crann, blocáil fógraí ionsuite, agus na rialuithe { -brand-short-name } a bhfuil súil agat leo.
waterfox-upgrade-dialog-primary-button = Tosaigh ag brabhsáil
waterfox-upgrade-dialog-continue-button = Lean ar aghaidh
waterfox-upgrade-dialog-appearance-title = Roghnaigh do chuma
waterfox-upgrade-dialog-appearance-subtitle = Coinnigh do chuma reatha, nó roghnaigh Nova, Proton, nó Photon. Is féidir leat é seo a athrú níos déanaí i Socruithe.
waterfox-upgrade-dialog-tabs-subtitle = Coinnigh an stiall chlasaiceach cluaisíní, nó bain triail as cluaisíní ingearacha nó crannacha. Is féidir leat é seo a athrú níos déanaí i Socruithe.
waterfox-upgrade-dialog-blocker-title = Athraigh go blocáil fógraí ionsuite?
waterfox-upgrade-dialog-blocker-subtitle = Cuireann { -brand-short-name } bac ar fhógraí agus ar rianaitheoirí leis féin anois. Athraigh chun cuimhne a shábháil, nó lean ort ag úsáid { $extensionName }. Is féidir leat é seo a athrú am ar bith sna Socruithe.
waterfox-upgrade-dialog-blocker-primary-button = Bain úsáid as blocáil fógraí ionsuite
waterfox-upgrade-dialog-blocker-secondary-button = Coinnigh { $extensionName }
waterfox-upgrade-dialog-search-title = Bain triail as cuardach Qwant
waterfox-upgrade-dialog-search-subtitle = Is é Qwant an t-inneall cuardaigh réamhshocraithe do { -brand-short-name }. Ní dhéanann sé rianú ort féin ná ar do chuardaigh, agus is féidir leat athrú ar ais am ar bith sna Socruithe.
waterfox-upgrade-dialog-search-primary-button = Athraigh go Qwant
