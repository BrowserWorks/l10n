# “Account” can be localized, “Firefox” must be treated as a brand,
# and kept in English.
-fxaccount-brand-name =
    { $kasua ->
        [0] Waterfox kontu
        [k] Waterfox kontuak
        [n] Waterfox kontuan
        [tik] Waterfox kontutik
        [ra] Waterfox kontura
        [ko] Waterfox kontuko
        [ri] Waterfox kontuari
        [ren] Waterfox kontuaren
        [rekin] Waterfox kontuarekin
        [rako] Waterfox konturako
       *[a] Waterfox kontua
    }
