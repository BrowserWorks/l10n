preferences-doh-setting-ultra =
    .label = Ultra skydd
    .accesskey = U

preferences-doh-ultra-desc = { -brand-short-name } kommer att säkra DNS med Oblivious HTTP via Waterfoxs integritetsrelä för maximalt skydd.

preferences-doh-ultra-detailed-desc-1 = Använder Waterfoxs Oblivious HTTP-relä för att dölja DNS-frågor även från DNS-leverantören

preferences-doh-ultra-detailed-desc-2 = Ger ett extra krypteringslager utöver standard-DNS via HTTPS

preferences-doh-ultra-detailed-desc-3 = Maximalt DNS-sekretessskydd – ingen kan se vilka webbplatser du besöker

preferences-doh-ultra-fallback-mode = Reservbeteende:

preferences-doh-ultra-fallback-allowed = Tillåt reservfunktion till system-DNS om säker DNS misslyckas

preferences-doh-ultra-fallback-disabled = Gå aldrig tillbaka till system-DNS (webbplatser kanske inte laddas om säker DNS misslyckas)
