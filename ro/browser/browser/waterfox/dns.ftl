preferences-doh-setting-ultra =
    .label = Ultraprotecție
    .accesskey = U

preferences-doh-ultra-desc = { -brand-short-name } va folosi SND securizat cu Oblivious HTTP prin releul de intimitate al Waterfox, pentru protecție maximă.

preferences-doh-ultra-detailed-desc-1 = Folosește releul Oblivious HTTP al Waterfox pentru a ascunde cererile SND chiar și de furnizorul SND

preferences-doh-ultra-detailed-desc-2 = Furnizează un strat suplimentar de criptare, în plus față de SND prin HTTPS standard

preferences-doh-ultra-detailed-desc-3 = Protecție maximă a intimității SND: nimeni nu poate vedea ce situri vizitați

preferences-doh-ultra-fallback-mode = Comportament de rezervă:

preferences-doh-ultra-fallback-allowed = Permite rezerva la SND-ul sistemului dacă cel securizat nu funcționează

preferences-doh-ultra-fallback-disabled = Nu trece niciodată la SND-ul sistemului (siturile ar putea să nu se încarce, dacă SND-ul securizat cedează)
