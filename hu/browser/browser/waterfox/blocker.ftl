waterfox-blocker-header = Reklámblokkolás

waterfox-blocker-intro-description = Reklámok, követő parancsfájlok és más nem kívánt kérések blokkolása a gyorsabb oldalbetöltés és kevesebb zavaró elem érdekében.

waterfox-blocker-setting-on =
