# Variables:
#   $version (String) - The Waterfox release series, e.g. 6.7.
waterfox-upgrade-dialog-title = Willkommen bei { -brand-short-name } { $version }
waterfox-upgrade-dialog-primary-button = Jetzt surfen
waterfox-upgrade-dialog-continue-button = Weiter
waterfox-upgrade-dialog-appearance-title = Wählen Sie Ihr Design
waterfox-upgrade-dialog-appearance-subtitle = Behalten Sie Ihr aktuelles Design bei oder wählen Sie Nova, Proton oder Photon. Sie können dies später in den Einstellungen ändern.
waterfox-upgrade-dialog-subtitle = Dieses Update bietet eine neuere Browser-Engine, Baum-Tabs, einen integrierten Werbeblocker und die { -brand-short-name }-Steuerelemente, die Sie erwarten.
waterfox-upgrade-dialog-tabs-subtitle = Behalten Sie die klassische Tableiste bei oder probieren Sie vertikale oder Baum-Tabs aus. Sie können dies später in den Einstellungen ändern.
waterfox-upgrade-dialog-blocker-title = Auf den integrierten Werbeblocker umstellen?
waterfox-upgrade-dialog-blocker-subtitle = { -brand-short-name } blockiert nun von sich aus Werbung und Tracker. Schalten Sie die Funktion ein, um Speicherplatz zu sparen, oder nutzen Sie weiterhin { $extensionName }. Sie können diese Einstellung jederzeit in den Einstellungen ändern.
waterfox-upgrade-dialog-blocker-primary-button = Integrierten Werbeblocker verwenden
waterfox-upgrade-dialog-blocker-secondary-button = { $extensionName } beibehalten
waterfox-upgrade-dialog-search-title = Qwant-Suche ausprobieren
waterfox-upgrade-dialog-search-subtitle = Qwant ist die Standard-Suchmaschine von { -brand-short-name }. Sie verfolgt weder Sie noch Ihre Suchanfragen. Sie können in den Einstellungen jederzeit wieder zu einer anderen Suchmaschine wechseln.
waterfox-upgrade-dialog-search-primary-button = Zu Qwant wechseln
