preferences-doh-setting-ultra =
    .label = Ultra-protekto
    .accesskey = U

preferences-doh-ultra-desc = { -brand-short-name } uzos sekuran servon DNS kun protokolo Oblivious HTTP tra privateca prokurila servo de Waterfox por plej forta protekto.

preferences-doh-ultra-detailed-desc-1 = Uzas prokurilan servon de Waterfox kun protokolo Oblivious HTTP por kaŝi DNS-petojn eĉ de provizanto de servo DNS

preferences-doh-ultra-detailed-desc-2 = Provizas aldonan nivelon de ĉifrado preter norma DNS-per-HTTPS

preferences-doh-ultra-detailed-desc-3 = Maksimuma protekto de privateco por DNS - neniu povas vidi, kiujn retejojn vi vizitas

preferences-doh-ultra-fallback-mode = Konduto dum eraro:

preferences-doh-ultra-fallback-allowed = Permesi uzadon de sistema servo DNS, se sekura DNS eraras

preferences-doh-ultra-fallback-disabled = Neniam uzi sisteman servon DNS (retejoj povas ne ŝarĝiĝi, se sekura DNS ne funkcias)
