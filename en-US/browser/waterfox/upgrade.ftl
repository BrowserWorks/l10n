## Upgrade dialog

# Variables:
#   $version (String) - The Waterfox release series, e.g. 6.7.
waterfox-upgrade-dialog-title = Welcome to { -brand-short-name } { $version }

waterfox-upgrade-dialog-subtitle = This update brings a newer browser engine, tree tabs, built-in ad blocking, and the { -brand-short-name } controls you expect.

waterfox-upgrade-dialog-primary-button = Start browsing

waterfox-upgrade-dialog-continue-button = Continue

waterfox-upgrade-dialog-appearance-title = Choose your look

waterfox-upgrade-dialog-appearance-subtitle = Keep your current look, or choose Nova, Proton, or Photon. You can change this later in Settings.

waterfox-upgrade-dialog-tabs-subtitle = Keep the classic tab strip, or try vertical or tree tabs. You can change this later in Settings.

waterfox-upgrade-dialog-blocker-title = Switch to built-in ad blocking?

# Variables:
#   $extensionName (String) - Name of the installed ad blocking extension, e.g. uBlock Origin.
waterfox-upgrade-dialog-blocker-subtitle = { -brand-short-name } now blocks ads and trackers on its own. Switch to save memory, or keep using { $extensionName }. You can change this any time in Settings.

waterfox-upgrade-dialog-blocker-primary-button = Use built-in ad blocking

# Variables:
#   $extensionName (String) - Name of the installed ad blocking extension, e.g. uBlock Origin.
waterfox-upgrade-dialog-blocker-secondary-button = Keep { $extensionName }

waterfox-upgrade-dialog-search-title = Try Qwant search

waterfox-upgrade-dialog-search-subtitle = Qwant is the { -brand-short-name } default search engine. It does not track you or your searches, and you can switch back any time in Settings.

waterfox-upgrade-dialog-search-primary-button = Switch to Qwant
