geolocation-api-header = API геолокации
geolocation-description = Некоторые веб-сайты требуют ваше местоположение. Если веб-сайт не функционирует в результате невозможности найти ваше местоположение, пожалуйста, включите эту настройку и повторите попытку.
geolocation-api-enabled =
    .label = Включено
geolocation-api-disabled =
    .label = Отключено
send-referrer-header-0 =
    .label = Никогда не отправлять заголовок источника запроса
send-referrer-header-1 =
    .label = Включать заголовок источника запроса только при нажатии на ссылки и похожие элементы
send-referrer-header-2 =
    .label = Включать заголовок источника запроса по всем запросам (по умолчанию)
enable-webrtc-p2p =
    .label = Включить peer-соединения WebRTC
    .description = Применяется к страницам, загруженным после изменения этого параметра.
load-images =
    .label = Автоматически загружать изображения
    .description = Применяется к последующей загрузке изображений на страницах HTTP и HTTPS.
enable-javascript =
    .label = Включить JavaScript
    .description = Применяется к страницам, загруженным после изменения этого параметра.
webrtc-header = Peer-соединения WebRTC
ref-header = HTTP заголовок источника запроса
telemetry-page-subtitle = Waterfox не собирает телеметрию о вашей установке — любые модули телеметрии отключены при сборке браузера. То, что вы делаете в браузере, известно только вам.
telemetry-privacy-policy = Политика конфиденциальности
waterfox-data-collection-header = { -brand-short-name } Сбор данных и использование
    .searchkeywords = приватность телеметрия сбор данных политика конфиденциальности
waterfox-data-collection-group =
    .label = { -brand-short-name } Сбор данных и использование
    .description = { -brand-short-name } не собирает телеметрию или данные об использовании. Дополнительные сервисы, такие как синхронизация, могут регулироваться собственными уведомлениями о конфиденциальности.
    .searchkeywords = приватность телеметрия сбор данных политика конфиденциальности
identity-allow-site-data = Всегда сохранять куки и данные для этого сайта
waterfox-data-collection-link = Просмотреть уведомление о конфиденциальности
waterfox-advanced-web-privacy-group =
    .label = Расширенная веб-приватность
    .description = Управление глобальным поведением подключений и referrer для веб-сайтов.
waterfox-web-content-group =
    .label = Содержимое веб-страниц
    .description = Эти настройки применяются глобально ко всем веб-сайтам.
waterfox-referrer-header-policy =
    .label = Политика заголовка Referrer
    .description = Политики сайтов и средства защиты приватности всё равно могут обрезать или не отправлять этот заголовок.
waterfox-extension-controlling-setting = <img data-l10n-name="icon"/> <strong>{ $name }</strong> управляет этим параметром.
