geolocation-api-header = API геолокации
geolocation-description = Некоторые веб-сайты требуют ваше местоположение. Если веб-сайт не функционирует в результате невозможности найти ваше местоположение, пожалуйста, включите эту настройку и повторите попытку.
geolocation-api-enabled =
