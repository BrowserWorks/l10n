preferences-doh-setting-ultra =
    .label = Ultra-suojaus
    .accesskey = U

preferences-doh-ultra-fallback-mode = Varatoiminnallisuus:

preferences-doh-ultra-detailed-desc-1 = Käyttää Waterfoxin Oblivious HTTP -välittäjää piilottaakseen DNS-kyselyt jopa DNS-palveluntarjoajalta

preferences-doh-ultra-detailed-desc-2 = Tarjoaa lisäsuojausta tavanomaisen DNS HTTPS:n lisäksi

preferences-doh-ultra-desc = { -brand-short-name } käyttää suojauksen maksimoimiseen turvallista nimipalvelinta Oblivious HTTP:llä Waterfoxin yksityisyysreleoinnin kautta.

preferences-doh-ultra-detailed-desc-3 = Korkein DNS-yksityisyyssuojaus - kukaan ei voi nähdä millä sivuilla vierailet

preferences-doh-ultra-fallback-allowed = Salli järjestelmän DNS:n käyttöön, jos turvallinen DNS ei toimi

preferences-doh-ultra-fallback-disabled = Älä koskaan salli järjestelmän DNS:n käyttöä (sivut eivät ehkä lataudu, jos turvallinen DNS ei toimi)
