geolocation-api-header = API de geolocalización
geolocation-description = Algunos sitios web requieren su ubicación para funcionar. Si un sitio web no funciona porque no puede detectar su ubicación, habilite esta preferencia y vuelva a intentarlo.
geolocation-api-enabled =
    .label = Activar
geolocation-api-disabled =
    .label = Desactivar
send-referrer-header-0 =
    .label = Nunca enviar la cabecera «referrer»
send-referrer-header-1 =
    .label = Enviar solo para navegaciones de documentos
send-referrer-header-2 =
    .label = Enviar para navegaciones y recursos de página (predeterminado)
enable-webrtc-p2p =
    .label = Habilitar la conexión entre pares WebRTC
    .description = Se aplica a las páginas que se carguen después de cambiar esta configuración.
load-images =
    .label = Cargar imágenes automáticamente
    .description = Se aplica a cargas de imágenes futuras en páginas HTTP y HTTPS.
enable-javascript =
    .label = Activar JavaScript
    .description = Aplica a las páginas que se carguen después de cambiar esta configuración.
webrtc-header = Conexión con pares WebRTC
ref-header = Encabezado de HTTP
telemetry-page-subtitle = Waterfox no recopila telemetría sobre tu instalación: todos los módulos de telemetría se desactivan al compilar el navegador. Lo que haces en tu navegador solo lo sabes tú.
telemetry-privacy-policy = Política de privacidad
waterfox-data-collection-header = { -brand-short-name } Recopilación y uso de datos
    .searchkeywords = privacidad telemetría recopilación de datos aviso de privacidad
waterfox-data-collection-description = { -brand-short-name } no recopila datos de telemetría ni de uso. Los servicios opcionales, como Sync, pueden regirse por sus propios avisos de privacidad. El <a data-l10n-name="privacy-notice">Aviso de privacidad</a> se proporciona aquí para una consulta rápida.
waterfox-data-collection-group =
    .label = { -brand-short-name } Recopilación y uso de datos
    .description = { -brand-short-name } no recopila datos de telemetría ni de uso. Los servicios opcionales, como Sync, pueden regirse por sus propios avisos de privacidad.
    .searchkeywords = privacidad telemetría recopilación de datos aviso de privacidad
waterfox-data-collection-link = Aviso de privacidad
identity-allow-site-data = Almacenar siempre cookies/datos para este sitio
waterfox-advanced-web-privacy-group =
    .label = Privacidad web avanzada
    .description = Controla el comportamiento global de conexión y del referente para los sitios web.
waterfox-web-content-group =
    .label = Contenido web
    .description = Estos ajustes se aplican globalmente a todos los sitios web.
waterfox-referrer-header-policy =
    .label = Política de la cabecera «referrer»
    .description = Las políticas de los sitios y las protecciones de privacidad aún pueden recortar u omitir la cabecera.
waterfox-extension-controlling-setting = <img data-l10n-name="icon"/> <strong>{ $name }</strong> controla este ajuste.
