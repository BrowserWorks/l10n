update-application-manual =
    .label = No buscar actualizaciones nunca (no recomendado)
    .accesskey = N
waterfox-update-application-auto =
    .label = Descargar e instalar las actualizaciones automáticamente al reiniciar (recomendado)
    .accesskey = A
waterfox-update-application-notify =
    .label = Buscar actualizaciones y preguntar antes de descargarlas
    .accesskey = C
waterfox-update-application-disabled =
    .label = No buscar actualizaciones automáticamente (no recomendado)
    .description = Las comprobaciones manuales siguen disponibles.
    .accesskey = D
waterfox-update-application-warning-cross-user-setting =
    .message = Las opciones de descarga automática se aplican a toda la instalación en Windows, mientras que desactivar las comprobaciones automáticas solo se aplica a este perfil.
waterfox-settings-exclusive-badge = Exclusivo de Waterfox
