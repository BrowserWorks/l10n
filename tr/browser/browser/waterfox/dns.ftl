preferences-doh-setting-ultra =
    .label = Ultra Koruma
    .accesskey = U

preferences-doh-ultra-desc = { -brand-short-name }, maksimum koruma için Waterfox'un gizlilik rölesi aracılığıyla Oblivious HTTP ile güvenli DNS kullanacaktır.

preferences-doh-ultra-detailed-desc-1 = DNS sorgularını DNS sağlayıcısından bile gizlemek için Waterfox'un Oblivious HTTP rölesini kullanır

preferences-doh-ultra-detailed-desc-2 = HTTPS üzerinden standart DNS'nin ötesinde ek bir şifreleme katmanı sağlar

preferences-doh-ultra-detailed-desc-3 = Maksimum DNS gizlilik koruması - ziyaret ettiğiniz siteleri kimse göremez

preferences-doh-ultra-fallback-mode = Yedek davranış:

preferences-doh-ultra-fallback-allowed = Güvenli DNS başarısız olursa sistem DNS'ine geri dönülmesine izin ver

preferences-doh-ultra-fallback-disabled = Asla sistem DNS'ine geri dönmeyin (güvenli DNS başarısız olursa siteler yüklenmeyebilir)
