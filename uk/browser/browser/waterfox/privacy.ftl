geolocation-api-header = API геолокації

geolocation-description = Для роботи деяких вебсайтів потрібне ваше розташування. Якщо вебсайт не працює через те, що не може визначити ваше розташування, увімкніть цей параметр і спробуйте ще раз.

geolocation-api-enabled =
    .label = Увімкнено

geolocation-api-disabled =
    .label = Вимкнено

enable-javascript =
    .label = Увімкнути JavaScript

load-images =
    .label = Автоматично завантажувати зображення

ref-header = Заголовок Referrer HTTP

send-referrer-header-0 =
    .label = Ніколи не надсилати заголовок Referrer

send-referrer-header-1 =
    .label = Включати заголовок реферера лише під час натискання на посилання та подібні елементи

send-referrer-header-2 =
    .label = Включати заголовок реферера до всіх запитів (за замовчуванням)

webrtc-header = WebRTC peer connection (з’єднання з іншими вузлами WebRTC)

enable-webrtc-p2p =
    .label = Увімкнути WebRTC peer connection

telemetry-page-subtitle = Waterfox не збирає телеметрію про вашу інсталяцію — будь-які модулі телеметрії відключені ще на етапі складання браузера. Те, що ви робите у вашому браузері, відомо лише вам.

telemetry-privacy-policy = Політика конфіденційності

waterfox-data-collection-header = { -brand-short-name } Збір та використання даних
    .searchkeywords = приватність телеметрія дані збір політика конфіденційності

waterfox-data-collection-description = { -brand-short-name } не збирає телеметрію чи дані про використання. Додаткові сервіси, такі як Sync, можуть регулюватися власними окремими політиками конфіденційності. <a data-l10n-name="privacy-notice">Політика конфіденційності</a> надана тут для зручного ознайомлення.
