geolocation-api-header = API геолокації
geolocation-description = Для роботи деяких вебсайтів потрібне ваше розташування. Якщо вебсайт не працює через те, що не може визначити ваше розташування, увімкніть цей параметр і спробуйте ще раз.
geolocation-api-enabled =
    .label = Увімкнути
geolocation-api-disabled =
    .label = Вимкнено
enable-javascript =
    .label = Увімкнути JavaScript
    .description = Застосовується до сторінок, завантажених після зміни цього налаштування.
load-images =
    .label = Автоматично завантажувати зображення
    .description = Застосовується до майбутніх завантажень зображень на сторінках HTTP та HTTPS.
ref-header = Заголовок HTTP-реферер
send-referrer-header-0 =
    .label = Ніколи не надсилати реферер
send-referrer-header-1 =
    .label = Надіслати лише для навігації документами
send-referrer-header-2 =
    .label = Надсилати для навігації та ресурсів сторінки (типово)
webrtc-header = WebRTC peer connection (з’єднання з іншими вузлами WebRTC)
enable-webrtc-p2p =
    .label = Увімкнути пірингові з’єднання WebRTC
    .description = Застосовується до сторінок, завантажених після зміни цього налаштування.
telemetry-page-subtitle = Waterfox не збирає телеметрію про ваше встановлення — будь-які модулі телеметрії вимкнені ще на етапі збірки браузера. Те, що ви робите у вашому браузері, відомо лише вам.
telemetry-privacy-policy = Політика приватності
waterfox-data-collection-header = { -brand-short-name } Збір та використання даних
    .searchkeywords = приватність телеметрія дані збір політика конфіденційності
waterfox-data-collection-description = { -brand-short-name } не збирає телеметрію чи дані про використання. Додаткові сервіси, такі як Sync, можуть регулюватися власними окремими політиками конфіденційності. <a data-l10n-name="privacy-notice">Політика конфіденційності</a> надана тут для зручного ознайомлення.
waterfox-data-collection-group =
    .label = { -brand-short-name } Збір та використання даних
    .description = { -brand-short-name } не збирає телеметрію чи дані про використання. Додаткові сервіси, такі як Sync, можуть регулюватися власними окремими політиками приватності.
    .searchkeywords = приватність телеметрія дані збір політика приватності
waterfox-data-collection-link = Переглянути політику приватності
identity-allow-site-data = Завжди зберігати кукі/дані для цього сайту
waterfox-advanced-web-privacy-group =
    .label = Розширена приватність в інтернеті
    .description = Керуйте глобальними з’єднаннями та поведінкою реферерів на вебсайтах.
waterfox-web-content-group =
    .label = Вебвміст
    .description = Ці налаштування застосовуються глобально до кожного вебсайту.
waterfox-extension-controlling-setting = <img data-l10n-name="icon"/> <strong>{ $name }</strong> керує цим параметром.
waterfox-referrer-header-policy =
    .label = Політика реферер заголовка
    .description = Політики сайтів та засоби захисту приватності все одно можуть обрізати або опускати цей заголовок.
