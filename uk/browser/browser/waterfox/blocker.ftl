waterfox-blocker-header = Блокування реклами

waterfox-blocker-intro-description = Блокує рекламу, скрипти відстеження та інші небажані запити для швидшого завантаження сторінок та меншої кількості відволікаючих факторів.

waterfox-blocker-setting-on =
    .label = Увімкнено

waterfox-blocker-setting-on-summary = Блокує рекламу та трекери з мінімальним впливом на завантаження сторінки.

